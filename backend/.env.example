# 把這個檔案複製成 .env，再填入自己的值
# .env 不會被推到 GitHub（在 .gitignore 裡）

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/bug_tracker?schema=public"
PORT=3000

# 部署到 Render 後填入 Vercel 前端網址，限制只允許這個網域呼叫 API。
# 多個網址用逗號分隔。本機開發留空就會放行所有來源。
# FRONTEND_URL=https://your-app.vercel.app

# Supabase Storage（圖片附件用）
# 1. 到 https://supabase.com 建專案
# 2. Storage → 建一個 Public bucket（例如 bug-attachments）
# 3. Project Settings → API → 拿 Project URL 和 Secret key
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_YOUR_SECRET_KEY"
SUPABASE_BUCKET="bug-attachments"
